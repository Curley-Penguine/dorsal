# Which language model drives the agent: offline | anthropic | openai
DORSAL_LLM=offline
# Anthropic (Claude)
ANTHROPIC_API_KEY=
DORSAL_ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint (e.g. DeepSeek, Qwen, OpenAI)
OPENAI_API_KEY=
DORSAL_OPENAI_BASE_URL=
DORSAL_OPENAI_MODEL=
# Security
DORSAL_OWNER_PIN=2468            # change this outside the sandbox
DORSAL_APPROVAL_SECRET=          # random string; signs approval tokens

{"seq": 13, "ts": "2026-10-15T04:30:35+00:00", "actor": "agent", "event": "action.proposed", "data": {"action": {"id": "reschedule_bill:f81b173a39", "type": "reschedule_bill", "tier": "commit", "title": "Move the Northline Equipment purchase ($7,600) to Jan 09", "rationale": "This is a planned purchase, not an obligation. Paying on Jan 09 keeps $7,600 in the bank through the low point.", "cost": 0.0, "counterparty": "sales@northline-equip.example", "params": {"bill_id": "B-902", "new_date": "2027-01-09"}, "draft": "Subject: New delivery date for Q-4471\n\nHi,\n\nPlease move our order Q-4471 to a Jan 09 delivery and invoice date at the quoted price.\n\nThanks,\nHarbor Lane Coffee Roasters", "proposed_by": "llm", "payload_hash": "f81b173a3979431a42dc86edce23584acb4383c5d8b09ea41e43f5fb181a5e00"}}, "prev": "9a841700b959d6db9b3cd9c64d2af164a546ad47806455d9f0a664ec922a510c", "hash": "4a1a48607b84f2eabd719250dd44c6087c06575f875a3ad973dd5708b36502d7"}

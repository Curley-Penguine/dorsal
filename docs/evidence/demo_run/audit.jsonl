{"seq": 10, "ts": "2026-10-15T04:30:35+00:00", "actor": "agent", "event": "action.proposed", "data": {"action": {"id": "request_split:0b41d31364", "type": "request_split", "tier": "commit", "title": "Use the split-payment option on Pacific Green Imports PG-2291 ($48,000)", "rationale": "Your agreement with Pacific Green Imports allows paying large orders in two halves. Paying $24,000 on Nov 20 and the rest on Dec 18 moves half the bill past the low point at no cost.", "cost": 0.0, "counterparty": "billing@pacificgreen.example", "params": {"bill_id": "B-901", "payments": [["2026-11-20", 24000.0], ["2026-12-18", 24000.0]]}, "draft": "Subject: Split payment for PG-2291\n\nHi,\n\nWe would like to use the split-payment option in our supply agreement for PG-2291 ($48,000.00): $24,000.00 on Nov 20 and $24,000.00 on Dec 18. Please confirm.\n\nThanks,\nHarbor Lane Coffee Roasters", "proposed_by": "llm", "payload_hash": "0b41d313641251270f6ef08063fed5ce31628e46f9b2b63e731f336e6acde778"}}, "prev": "4b718e72b68a985cc84926a1e9ab8064e67a298c4f3739170329b98a14f2788d", "hash": "bd18fd21746e981e8f91f87f9ce055d94eb54b19fa0d52ad6506255d894f2b02"}
